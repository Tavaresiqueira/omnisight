[Unit]
Description=OmniSight encrypted PostgreSQL backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=omnisight-backup
EnvironmentFile=/etc/omnisight/backup.env
ExecStart=/bin/bash /opt/omnisight/deploy/backup/backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/omnisight
