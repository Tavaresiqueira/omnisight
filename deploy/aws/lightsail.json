{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "OmniSight single-node pilot. Creates billable resources; review Free Tier credits first.",
  "Parameters": {
    "InstanceName": {"Type":"String","Default":"omnisight-pilot"},
    "AvailabilityZone": {"Type":"String","Description":"Supported Lightsail AZ, for example us-east-1a"},
    "BlueprintId": {"Type":"String","Description":"x86_64 Ubuntu 24.04 blueprint ID returned by get-blueprints"},
    "BundleId": {"Type":"String","Description":"x86_64 Linux IPv4 bundle with at least 2 GB; get-bundles supplies exact ID"},
    "SshCidr": {"Type":"String","AllowedPattern":"^([0-9]{1,3}\\.){3}[0-9]{1,3}/32$","Description":"Your public IPv4 followed by /32"}
  },
  "Resources": {
    "Instance": {
      "Type":"AWS::Lightsail::Instance",
      "Properties": {
        "InstanceName":{"Ref":"InstanceName"},
        "AvailabilityZone":{"Ref":"AvailabilityZone"},
        "BlueprintId":{"Ref":"BlueprintId"},
        "BundleId":{"Ref":"BundleId"},
        "Networking":{"Ports":[
          {"FromPort":22,"ToPort":22,"Protocol":"tcp","Cidrs":[{"Ref":"SshCidr"}]},
          {"FromPort":80,"ToPort":80,"Protocol":"tcp","Cidrs":["0.0.0.0/0"]},
          {"FromPort":443,"ToPort":443,"Protocol":"tcp","Cidrs":["0.0.0.0/0"]}
        ]},
        "UserData":"#!/bin/bash\nset -eu\napt-get update\napt-get install -y docker.io docker-compose-v2 unzip\nsystemctl enable --now docker\ninstall -d -m 0750 -o ubuntu -g ubuntu /opt/omnisight\n",
        "Tags":[{"Key":"Project","Value":"OmniSight"},{"Key":"Environment","Value":"pilot"}]
      }
    },
    "StaticIp":{"Type":"AWS::Lightsail::StaticIp","Properties":{"StaticIpName":{"Fn::Sub":"${InstanceName}-ip"},"AttachedTo":{"Ref":"Instance"}}}
  },
  "Outputs": {
    "PublicIp":{"Value":{"Fn::GetAtt":["StaticIp","IpAddress"]}},
    "Instance":{"Value":{"Ref":"Instance"}}
  }
}
